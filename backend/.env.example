# Base de datos (Supabase, Railway, Render o local)
DATABASE_URL="postgresql://usuario:password@localhost:5432/reservame"

# Puerto del servidor
PORT=4000

# URL del frontend (para CORS y para armar el link del magic link / redirects)
FRONTEND_URL="http://localhost:3000"

# Secreto para firmar el JWT de sesión (cámbialo en producción)
JWT_SECRET="cambia-este-secreto-en-produccion"
JWT_EXPIRES_IN="12h"

# Proveedor de autenticación activo: "magic_link" (Plan B, provisional) o "entra_id" (Plan A, definitivo)
AUTH_PROVIDER="magic_link"

# Correo del primer Administrador del sistema (se crea en el seed — sección 4 del doc técnico:
# el primer Administrador no puede auto-asignarse desde la app, se crea manualmente al desplegar)
ADMIN_EMAIL="admin@colegio.cl"
ADMIN_NOMBRE="Admin Sistema"

# --- Envío de correo (canal de respaldo de notificaciones, sección 8 del doc técnico) ---
# Mientras no esté aprobado Microsoft Graph, usar un correo transaccional gratuito (Resend, Brevo).
# Si se deja vacío, el proveedor de email por defecto solo hace console.log (modo desarrollo).
RESEND_API_KEY=""
EMAIL_FROM="ReservaMe <no-responder@colegio.cl>"

# --- Plan A (Entra ID) — completar cuando el sostenedor apruebe el registro de la app ---
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""
