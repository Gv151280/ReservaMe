// Modelo de datos de ReservaMe — Fase -1
// Basado en Documento-Tecnico-ReservaMe-Fase1.md, sección 3, más las extensiones
// acordadas después: horario con horas de clase reales (BloqueClase), equipamiento
// configurable por sala y solicitado por reserva.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Colegio {
  id       String                 @id @default(uuid())
  nombre   String
  usuarios Usuario[]
  salas    Sala[]
  horarios HorarioInstitucional[]

  @@map("colegio")
}

model Usuario {
  id                 String   @id @default(uuid())
  colegioId          String   @map("colegio_id")
  colegio            Colegio  @relation(fields: [colegioId], references: [id])
  nombre             String
  emailInstitucional String   @unique @map("email_institucional")
  entraIdOid         String?  @unique @map("entra_id_oid")
  activo             Boolean  @default(true)
  creadoEn           DateTime @default(now()) @map("creado_en")

  roles           UsuarioRol[]
  reservas        Reserva[]
  salasEncargadas Sala[]         @relation("EncargadoSala")
  notificaciones  Notificacion[]

  @@map("usuario")
}

model Rol {
  id      String       @id @default(uuid())
  nombre  String       @unique // docente | encargado_sala | administrador
  usuarios UsuarioRol[]

  @@map("rol")
}

model UsuarioRol {
  usuarioId String @map("usuario_id")
  rolId     String @map("rol_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol       Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuario_rol")
}

// itemsEquipamiento: lista de equipos que se pueden pedir al reservar esta sala.
// Cada ítem: { "nombre": "Notebooks", "tieneCantidad": true, "cantidadMaxima": 20 }
// (tieneCantidad=false para ítems de sí/no, como "Proyector" o "Audio").
model Sala {
  id                String   @id @default(uuid())
  colegioId         String   @map("colegio_id")
  colegio           Colegio  @relation(fields: [colegioId], references: [id])
  nombre            String
  capacidad         Int?
  equipamiento      String?
  modoReserva       String   @default("autoservicio") @map("modo_reserva") // ya no se usa para decidir aprobación (ver Reserva.estado), se deja por compatibilidad
  itemsEquipamiento Json     @default("[]") @map("items_equipamiento")
  encargadoId       String?  @map("encargado_id")
  encargado         Usuario? @relation("EncargadoSala", fields: [encargadoId], references: [id])
  activa            Boolean  @default(true)

  reservas Reserva[]

  @@map("sala")
}

// equipamientoSolicitado: lo que el docente pidió en ESA reserva puntual.
// [{ "nombre": "Notebooks", "cantidad": 10 }, { "nombre": "Proyector" }]
model Reserva {
  id                     String   @id @default(uuid())
  salaId                 String   @map("sala_id")
  sala                   Sala     @relation(fields: [salaId], references: [id])
  usuarioId              String   @map("usuario_id")
  usuario                Usuario  @relation(fields: [usuarioId], references: [id])
  tipoUso                String   @map("tipo_uso") // clase | reunion_otro
  fechaInicio            DateTime @map("fecha_inicio")
  fechaFin               DateTime @map("fecha_fin")
  estado                 String   @default("pendiente") // pendiente | confirmada | rechazada | cancelada
  motivoRechazo          String?  @map("motivo_rechazo")
  equipamientoSolicitado Json     @default("[]") @map("equipamiento_solicitado")
  creadoEn               DateTime @default(now()) @map("creado_en")

  notificaciones Notificacion[]

  @@index([salaId, fechaInicio, fechaFin])
  @@map("reserva")
}

model Notificacion {
  id             String    @id @default(uuid())
  reservaId      String    @map("reserva_id")
  reserva        Reserva   @relation(fields: [reservaId], references: [id])
  destinatarioId String    @map("destinatario_id")
  destinatario   Usuario   @relation(fields: [destinatarioId], references: [id])
  canal          String    // push | email
  mensaje        String
  estadoEnvio    String    @default("pendiente") @map("estado_envio") // enviado | fallido | pendiente
  leida          Boolean   @default(false)
  enviadoEn      DateTime? @map("enviado_en")
  creadoEn       DateTime  @default(now()) @map("creado_en")

  @@map("notificacion")
}

// Horario institucional configurable por día de la semana (0=domingo .. 6=sábado).
// El Administrador define la lista real de horas de clase de cada día — cada una
// con su propio inicio y fin — y los recreos quedan implícitos como los espacios
// entre una hora y la siguiente (pueden durar distinto entre sí).
model HorarioInstitucional {
  id                   String  @id @default(uuid())
  colegioId            String  @map("colegio_id")
  colegio              Colegio @relation(fields: [colegioId], references: [id])
  diaSemana            Int     @map("dia_semana")
  abierto              Boolean @default(true)
  horaInicio           Int     @map("hora_inicio") // apertura del colegio (límite inferior para "reunión/otro")
  horaSalidaProfesores Int     @map("hora_salida_profesores") // límite superior para "reunión/otro"

  bloques BloqueClase[]

  @@unique([colegioId, diaSemana])
  @@map("horario_institucional")
}

// Una hora de clase real dentro de un día del horario institucional.
model BloqueClase {
  id         String               @id @default(uuid())
  horarioId  String               @map("horario_id")
  horario    HorarioInstitucional @relation(fields: [horarioId], references: [id], onDelete: Cascade)
  horaInicio Int                  @map("hora_inicio")
  horaFin    Int                  @map("hora_fin")

  @@map("bloque_clase")
}

// Tokens de un solo uso para el login provisional por magic link (Plan B, sección 7).
model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  creadoEn  DateTime  @default(now()) @map("creado_en")

  @@map("magic_link_token")
}
